# HeritageAR environment variables
# Copy the relevant values below and fill them in.

# Flask session secret (change for production)
SECRET_KEY=dev-key

# --- Firebase Authentication ---
# 1. Put your service-account JSON at the project root as
#    firebase-service-account.json  (or set FIREBASE_CREDENTIALS to its path).
# FIREBASE_CREDENTIALS=firebase-service-account.json

# 2. Web API key from Firebase console -> Project settings -> General.
#    Needed for login password verification.
# FIREBASE_API_KEY=your-web-api-key
